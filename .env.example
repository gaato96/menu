# ---------------------------------------------------------------------------
# Supabase
# Project region: sa-east-1 (São Paulo). A local in Tucumán against us-east
# adds ~200ms to the checkout, which is the one request that must feel instant.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS — used by the order endpoint to price orders and by
# the superadmin panel. Never expose to the browser, never prefix with NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Web Push (VAPID)
# Generate with: npm run push:keys
# ---------------------------------------------------------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:agencia.gutmark@gmail.com

# ---------------------------------------------------------------------------
# Gemini — AI dish photos (src/lib/ai/gemini.ts)
# Server-only. Left empty, the feature reports itself as unconfigured rather
# than failing at build time.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=

# Defaults to gemini-2.5-flash-image, the image model that HAS a free tier —
# on a project with no billing account it generates at no cost and returns 429
# once the daily allowance is spent. Set this to gemini-3.1-flash-image
# (US$0.067/image) for better quality once there is a paying client.
GEMINI_IMAGE_MODEL=

# Only used when the primary model is rate-limited. UNSET BY DEFAULT ON
# PURPOSE: with no fallback, a spent free allowance stops the feature instead
# of quietly rolling onto a paid model. Set it only when you accept the spend.
GEMINI_IMAGE_MODEL_FALLBACK=

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
