# ---------------------------------------------------------------------------
# Supabase
# Project region: sa-east-1 (São Paulo). A local in Tucumán against us-east
# adds ~200ms to the checkout, which is the one request that must feel instant.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS — used by the order endpoint to price orders and by
# the superadmin panel. Never expose to the browser, never prefix with NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Web Push (VAPID)
# Generate with: npm run push:keys
# ---------------------------------------------------------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:agencia.gutmark@gmail.com

# ---------------------------------------------------------------------------
# Gemini — AI dish photos (src/lib/ai/gemini.ts)
# Server-only. Costs real money per image (US$0.067 at 1K), so the panel caps
# each business at AI_IMAGES_MONTHLY_QUOTA generations a month. Needs billing
# enabled on the Google Cloud project, not just a free-tier key.
# Left empty the feature reports itself as unconfigured instead of failing.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
