# ---------------------------------------------------------------------------
# Supabase
# Project region: sa-east-1 (São Paulo). A local in Tucumán against us-east
# adds ~200ms to the checkout, which is the one request that must feel instant.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS — used by the order endpoint to price orders and by
# the superadmin panel. Never expose to the browser, never prefix with NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Web Push (VAPID)
# Generate with: npm run push:keys
# ---------------------------------------------------------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:agencia.gutmark@gmail.com

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
